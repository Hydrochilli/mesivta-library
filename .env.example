# Supabase project for the Mesivta Library site (announcements, events, resources).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_KEY=

# Production URL of the Mesivta Code (dev branch) deployment, used for the nav link.
NEXT_PUBLIC_CODE_CLUB_URL=https://code.example.org

# Optional: only set this if you later get a public, embeddable OPAC URL.
# Catalog search otherwise runs natively against Supabase (see scripts/import-books-csv.mjs).
NEXT_PUBLIC_ABRACADABRA_OPAC_URL=
